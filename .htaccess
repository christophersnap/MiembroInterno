# ==============================================================================
# CRUZ VERDE SALVADOREÑA - ENRUTAMIENTO HOSTINGER + GITHUB
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirigir assets de Vite hacia la carpeta dist/assets si se solicitan desde la raíz
  RewriteCond %{REQUEST_URI} ^/assets/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 2. Si el archivo solicitado existe físicamente en dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Si el archivo solicitado existe en la raíz física (ej: favicon, robots)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Enrutamiento SPA: Servir dist/index.html para cualquier ruta (login, socorristas, etc.)
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^ dist/index.html [L]

  # 5. En caso alternativo, delegar al enrutador index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Tipos MIME para módulos de JavaScript y fuentes web
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
