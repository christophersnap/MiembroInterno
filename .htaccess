# ==============================================================================
# CRUZ VERDE SALVADOREÑA - ENRUTAMIENTO HOSTINGER + GITHUB
# ==============================================================================

# Prioridad de carga: servir la app compilada en dist/ o procesar por index.php
DirectoryIndex dist/index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reescribir la raíz (/) o /index.html directamente a dist/index.html compilado
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 2. Servir archivos estáticos de assets (/assets/... o /cualquier-ruta/assets/...)
  RewriteRule ^(?:.*/)?assets/(.*)$ assets/$1 [L,NC]

  # 3. Servir cualquier archivo físico que exista en la raíz (ej: favicon, assets, robots.txt)
  # Excluir index.html para evitar servir el template fuente no transpilado
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [L]

  # 4. Servir archivos físicos que existan dentro de dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 5. PREVENCIÓN CRÍTICA: Si la petición termina en una extensión de archivo estático
  # (.js, .css, .png, etc.) y NO se encontró, devolver 404 en lugar de devolver HTML.
  # Esto evita el error fatal: "Expected a JavaScript module script but received text/html"
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json|webp|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. Enrutamiento SPA: Servir dist/index.html para cualquier ruta de la app (/login, /socorristas, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ dist/index.html [L]

  # 7. Respaldo definitivo al enrutador PHP si dist/ no existiera
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.php [L]
</IfModule>

# Tipos MIME para módulos de JavaScript modernos y fuentes
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Compresión GZIP para máxima velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
