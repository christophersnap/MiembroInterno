# ==============================================================================
# CRUZ VERDE SALVADOREÑA - ENRUTAMIENTO HOSTINGER + GITHUB
# ==============================================================================

DirectoryIndex index.php dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Servir archivos físicos existentes en la raíz (assets, favicon, robots.txt, etc.)
  # Excluir index.html de la raíz para no servir el template de desarrollo
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [L]

  # 2. Si el archivo físico solicitado existe dentro de dist/
  RewriteCond dist%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Si se solicita la raíz (/) o /index.html explícitamente, delegar al router index.php
  RewriteRule ^$ index.php [L]
  RewriteRule ^index\.html$ index.php [L]

  # 4. Cualquier otra petición (rutas SPA /login, /socorristas y resolución inteligente de assets)
  # se delega a index.php, que se encarga de servir dist/index.html o el archivo correspondiente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Tipos MIME para módulos de JavaScript modernos y fuentes
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Compresión GZIP para máxima velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
