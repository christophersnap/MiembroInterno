# ==============================================================================
# CRUZ VERDE SALVADOREÑA - ENRUTAMIENTO HOSTINGER + GITHUB (/miembros)
# ==============================================================================

DirectoryIndex index.php dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Asegurar redirección canónica de /miembros a /miembros/ si entra sin barra final
  RewriteRule ^miembros$ /miembros/ [R=301,L]

  # 2. Servir archivos físicos existentes en la raíz o subdirectorio
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^.*index\.html$ [NC]
  RewriteRule ^ - [L]

  # 3. Servir assets directamente si existen dentro de dist/assets/
  RewriteCond %{DOCUMENT_ROOT}/miembros/dist/assets/$1 -f
  RewriteRule ^(?:miembros/)?assets/(.+)$ dist/assets/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^(?:miembros/)?assets/(.+)$ dist/assets/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/miembros/assets/$1 -f
  RewriteRule ^(?:miembros/)?assets/(.+)$ assets/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/assets/$1 -f
  RewriteRule ^(?:miembros/)?assets/(.+)$ assets/$1 [L]

  # 4. Si el archivo solicitado existe dentro de dist/
  RewriteCond dist%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/miembros/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 5. Delegar todas las demás rutas SPA a index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Tipos MIME para módulos de JavaScript modernos y fuentes
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Compresión GZIP para máxima velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
