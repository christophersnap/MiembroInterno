# ==============================================================================
# CRUZ VERDE SALVADOREÑA - ENRUTAMIENTO HOSTINGER + GITHUB
# ==============================================================================

DirectoryIndex dist/index.html index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Servir archivos físicos que existan directamente (assets, imágenes, etc.)
  # IMPORTANTE: Excluir index.html de la raíz para no servir el template sin compilar
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [L]

  # 2. Si el archivo físico existe dentro de dist/ (ej: dist/assets/archivo.js o dist/favicon.ico)
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Si se solicita la raíz (/) o /index.html explícitamente, servir dist/index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 4. Evitar devolver HTML si un recurso estático (.js, .css, etc.) no existe físicamente
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json|webp|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 5. Enrutamiento SPA: Cualquier otra ruta no física (/login, /socorristas, /vehiculos, etc.)
  # se envía a dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ dist/index.html [L]

  # 6. Fallback final a index.php si dist/index.html no estuviese presente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.php [L]
</IfModule>

# Tipos MIME para módulos de JavaScript modernos y fuentes
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Compresión GZIP para máxima velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
